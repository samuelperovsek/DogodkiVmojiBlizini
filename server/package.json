{
  "name": "dogodki-server",
  "version": "1.0.0",
  "description": "Backend za DogodkiVMojiBlizini.si",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "predev": "lsof -ti:3001 | xargs kill -9 2>/dev/null; exit 0",
    "dev": "node --watch server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:reset": "docker compose down -v 2>/dev/null; docker rm -f mysql_dogodki 2>/dev/null; docker compose up -d && echo '⏳ Cakam, da MySQL postane pripravljen...' && sleep 6 && echo '✓ Baza resetirana iz init.sql'"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.11.5",
    "tailwindcss": "^4.3.0"
  }
}
